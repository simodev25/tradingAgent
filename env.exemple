ENDPOINT_URL=https://instr-mamx31je-eastus2.openai.azure.com/
DEPLOYMENT_NAME=gpt-4.1
API_VERSION=2025-01-01-preview
AZURE_OPENAI_API_KEY=
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
ACCOUNT_ID=
API_TOKEN=


# --- SCORING de base (inchangé) ---
TA_RSI_LEN=9
TA_EMA_FAST=8
TA_EMA_SLOW=21
TA_MACD_SIGNAL=7
TA_ATR_LEN=10
TA_BB_LEN=14
TA_BB_MULT=1.8

# --- Stops (éviter les stops disproportionnés en scalping) ---
IND_MIN_STOP_TICKS_BASE=70          # ↓ 200 -> 60 (≈ 6 pips 5e digit)
IND_MINSTOP_ATR_FRAC=0.12          # ↓ 0.15 -> 0.10

# --- Volatilité / Regime (inchangé sauf si besoin) ---
VOL_ENABLED=true
VOL_LOOKBACK_DAYS=60 
VOL_LOW_PCT=5
VOL_HIGH_PCT=92
VOL_EXTREME_PCT=98
VOL_SIZE_HIGH=0.7
VOL_MIN_SAMPLES_WINDOW=80
VOL_MIN_SAMPLES_FALLBACK=20
VOL_FALLBACK_TAIL=2000

REGIME_ATR_HIGH=0.006
REGIME_ATR_LOW=0.00025
REGIME_BBW_TREND=4.2
REGIME_SQUEEZE_BBW=2.6
TREND_ONLY=false

DEC_RSI_POS=53
DEC_RSI_NEG=47
SCORE_W_EMA=1.0
SCORE_W_MACD=1.0
SCORE_W_RSI=1.0
SCORE_W_BBPOS=1.0
DEC_TREND_BUY_SCORE=1
DEC_TREND_SELL_SCORE=-1
DEC_RANGE_BUY_SCORE=1
DEC_RANGE_SELL_SCORE=-1
REQUIRE_HTF_ON_EDGES=true           # ← exiger confluence HTF en zones limites

# --- Confiance (damping) ---
CONF_DAMP_START=0.004
CONF_DAMP_RANGE=0.01
CONF_DAMP_CAP=0.4

# --- Periods / TF ---
LTF_PERIOD_5M=5
LTF_PERIOD_15M=15
HTF_PERIOD_DAYS=30
HTF_INTERVAL=1h
D1_PERIOD_MONTHS=6

# --- Levels / Stops ---
LEVELS_MIN_ATR_FRACTION=0.08

# --- Profils (Phase 1) : resserrer le SL, allonger le TP, hausser min_conf ---
# + ajout d’un filtre tp_vs_spread_min (si ton code le lit)
PROFILE_OVERRIDES={
  "scalping":{
    "min_ticks":60,
    "rr_target":1.9,              # ↑ 1.45 -> 2.0
    "spread_frac":0.05,
    "sl_atr_mult":0.8,            # ↓ 0.9 -> 0.8
    "tp_atr_mult":2.2,            # ↑ 1.7 -> 2.0
    "min_confidence":60,          # ↑ 55 -> 62 (NORMAL vol)
    "tp_vs_spread_min":10,        # nouveau : TP distance >= 10x spread

    # --- Adaptation vol HIGH (nouveau : si ton code le lit) ---
    "min_confidence_high_vol":65, # vol HIGH ⇒ seuil de confiance plus strict
    "rr_target_high_vol":2.2      # vol HIGH ⇒ RR exigé plus élevé
  },
  "daytrade":{
    "spread_frac":0.05,
    "min_confidence":60
  }
}

# --- Management (post-trade) ---
MANAGE_MOVE_BE_AT_R=1.0
MANAGE_PARTIAL_AT_R=1.8            # ↑ 1.5 -> 1.8
MANAGE_PARTIAL_FRAC=0.5
MANAGE_TRAIL_AT_R=2.2              # ↑ 2.0 -> 2.2
MANAGE_TRAIL_TYPE=ATR
MANAGE_TRAIL_LEN=14
MANAGE_TIME_STOP_BARS=6

# --- Hedge (laisser ON mais univers réduit pour l’instant) ---
HEDGE_MODE=true
HEDGE_MAX_PAIRS=2                 # ↓ 2 -> 1 (Phase 1)
HEDGE_MAX_NET_USD_MULT=1.5         # ↓ 2.0 -> 1.5
HEDGE_RISK_SPLIT=0.6